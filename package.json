{
  "name": "dsh-sidebar-history",
  "version": "0.1.1",
  "description": "DeepSeek Harness (DSH) sidebar plugin with TODO progress, latest assistant reply previews, and searchable chat history",
  "type": "module",
  "license": "MIT",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/i18n",
    "docs/telemetry.md",
    "docs/discovery.md",
    "scripts/collect-telemetry.mjs",
    "docs/media/live/demo.mp4",
    "docs/media/live/feature-8s.gif",
    "docs/media/live/snapshot.png",
    "docs/media/live/evidence/result.json",
    "docs/media/live/provenance.json",
    "docs/media/live/qa.json",
    "docs/media/live/evidence/native-events.json",
    "docs/media/localized",
    "docs/media/locales.json"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/projection.test.mjs tests/candidate.test.mjs tests/telemetry.test.mjs tests/locale.test.mjs tests/localized-media.test.mjs tests/media-locales.test.mjs",
    "build": "node scripts/check.mjs && node scripts/check-docs.mjs",
    "verify": "npm test && npm run build",
    "verify:browser": "node scripts/browser-test.mjs",
    "verify:live": "node scripts/live-browser.mjs",
    "verify:commit": "node scripts/pre-commit.mjs",
    "setup:hooks": "node scripts/install-hooks.mjs",
    "record:live": "node scripts/live-browser.mjs --record",
    "verify:media": "node scripts/check-live-media.mjs && node scripts/check-localized-media.mjs",
    "telemetry:collect": "node scripts/collect-telemetry.mjs",
    "verify:docs": "node scripts/check-docs.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:media:locales": "node scripts/check-localized-media.mjs",
    "record:locales": "python3 scripts/record-localized-media.py"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liush2yuxjtu/dsh-sidebar-history.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek",
    "sidebar",
    "chat-history",
    "todo",
    "task-management",
    "ai-agent",
    "developer-tools",
    "web-ui",
    "dsh",
    "session-history",
    "plugin"
  ],
  "homepage": "https://liush2yuxjtu.github.io/dsh-sidebar-history/",
  "bugs": {
    "url": "https://github.com/liush2yuxjtu/dsh-sidebar-history/issues"
  }
}
